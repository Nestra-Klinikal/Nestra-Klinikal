# ---------------------------------------------------------------------------
# Nestra Klinikal — environment variables
#
# Copy this file to .env.local for local development, and set the same values
# in your Vercel project settings for staging and production.
#
# The site builds and runs with NONE of these set: it falls back to the seed
# content in src/lib/seed-content.ts. Set them to switch on the real CMS.
# ---------------------------------------------------------------------------


# --- Site -------------------------------------------------------------------

# The public address of the site, with no trailing slash. Used for canonical
# links, the sitemap, Open Graph tags and structured data.
# Default if unset: https://www.nestraklinikal.com
NEXT_PUBLIC_SITE_URL=https://www.nestraklinikal.com


# --- Sanity (the content management system) ---------------------------------

# Your Sanity project id. Find it at sanity.io/manage after creating a project.
# WITHOUT THIS the site renders seed content and /studio shows a setup notice.
NEXT_PUBLIC_SANITY_PROJECT_ID=17bfn45w

# The dataset name. "production" unless you deliberately created another.
NEXT_PUBLIC_SANITY_DATASET=production

# The API version, as a date. Leave as-is unless you have a reason to change it.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# A write token, needed ONLY so the website can save email leads into Sanity.
# Create it at sanity.io/manage -> API -> Tokens, with "Editor" permission.
# KEEP THIS SECRET. It has no NEXT_PUBLIC_ prefix so it never reaches a browser.
# Without it, forms still validate and confirm, but no lead is stored.
SANITY_API_WRITE_TOKEN=skf2QboAug6xvoigPMMTLXm5kg4dNg2McPwhu5npXqiLdiFLlRTO8B8giu8ydJAxWeLHnudUnc9RWD1EHLgvUOqMeauPJ1kVYXoVl025Y2EkcZn5c2c9KWNSj06KYaWH6UrYpFkVoGG1OM8zWLN115TlIooloofqjaRWzgiIVDKV3KR4H8Lm


# --- Email platform sync (entirely optional) --------------------------------
#
# Leads are always stored in Sanity and exportable as CSV from Studio. These
# settings additionally mirror each new address into an email marketing tool.
# Leave EMAIL_SYNC_PROVIDER empty to keep the mirror switched off.
#
# Accepted values: mailchimp | brevo | convertkit
EMAIL_SYNC_PROVIDER=

# If EMAIL_SYNC_PROVIDER=mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# If EMAIL_SYNC_PROVIDER=brevo
BREVO_API_KEY=
BREVO_LIST_ID=

# If EMAIL_SYNC_PROVIDER=convertkit
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=


# --- Testing (local only) ---------------------------------------------------

# Only needed if your machine has a preinstalled Chromium that does not match
# the browser build Playwright expects. Normally leave this unset.
PLAYWRIGHT_CHROMIUM_PATH=
